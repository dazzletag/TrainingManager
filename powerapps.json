                  - GetShifts:
                      Control: Classic/Icon@2.5.0
                      Properties:
                        BorderColor: =RGBA(0, 18, 107, 1)
                        Color: =RGBA(0, 18, 107, 1)
                        Height: =51
                        Icon: =Icon.AddToCalendar
                        OnSelect: "=//UpdateContext({ctxDragDropEvent:\"Reset\"&Rand()});\r\n//Day 1\r\nClear(Holidays);\r\nClear(PlandayShifts1);\r\nClear(PlandayShifts2);\r\n\r\nClearCollect(colCurrentDnD, Filter(PowerDragDrop2_1.CurrentItems,Text(DropZoneId)=Text(ThisItem.TrainingSessionD1)));\r\nClearCollect(colToPost,\r\n    Ungroup(\r\n        DropColumns(\r\n            AddColumns(\r\n                colCurrentDnD,\r\n                Mygroupedcolumn,\r\n                Filter(\r\n                    colSessions,\r\n                    Text(TrainingSessionD1)=Text(colCurrentDnD[@DropZoneId])\r\n                )\r\n            ),\r\n            DropZoneId\r\n        ),\r\n        Mygroupedcolumn\r\n    )\r\n);\r\n\r\nClearCollect(colToSend, \r\n    AddColumns(\r\n        colToPost,PositionID,\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Quarry House\",\"20843\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Beech House\",\"20842\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Field House\",\"20845\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Glebe House\",\"20728\",\"\")))),\r\n        GroupId,\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Quarry House\",\"21754\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Beech House\",\"21752\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Field House\",\"21755\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Glebe House\",\"21753\",\"\"))))));\r\n\r\n\r\nClearCollect(\r\n    PlandayShiftsRaw,\r\n    Planday.GetShifts({\r\n        from: Text(ThisItem.'Day 1', \"yyyy-mm-dd\"),\r\n        to:   Text(ThisItem.'Day 1', \"yyyy-mm-dd\"),\r\n        'X-ClientId': \"a079a6c5-a90f-45e9-8bd1-a1dcd3002cc3\",\r\n        offset:0,\r\n        Limit: \"5000\"\r\n    }).data\r\n);\r\n\r\nClearCollect(\r\n    PlandayShifts1,\r\n    Planday.GetShifts({\r\n        from: Text(ThisItem.'Day 1', \"yyyy-mm-dd\"),\r\n        to:   Text(ThisItem.'Day 1', \"yyyy-mm-dd\"),\r\n        'X-ClientId': \"a079a6c5-a90f-45e9-8bd1-a1dcd3002cc3\",\r\n        \r\n        Limit: \"5000\"\r\n    }).data\r\n);\r\nRemoveIf(PlandayShifts1, !(employeeId in Concat(colToSend,ItemId,\",\"))\r\n||Len(employeeId)<3\r\n);        \r\n\r\nForAll(PlandayShifts1,\r\n    If(PlandayShifts1[@shiftTypeId]=70768||Text(PlandayShifts1[@shiftTypeId])=\"70768\",\r\n        Collect(Holidays,{Name: LookUp(Withhomesx,Text(id)=Text(PlandayShifts1[@employeeId]),FullName),Type: \"Holiday\",Date: PlandayShifts1[@date]}),\r\n        If(PlandayShifts1[@shiftTypeId]=71868,\r\n            Collect(Holidays,{Name: LookUp(Withhomesx,Text(id)=Text(PlandayShifts1[@employeeId]),FullName),Type: \"Unpaid Leave\",Date: PlandayShifts1[@date]}),\r\n            If(PlandayShifts1[@shiftTypeId]=71851,\r\n                Collect(Holidays,{Name: LookUp(Withhomesx,Text(id)=Text(PlandayShifts1[@employeeId]),FullName),Type: \"Sick Leave\",Date: PlandayShifts1[@date]}),\r\n                Collect(Updates,Planday.UpdateShift(PlandayShifts1[@id],{\r\n                    'X-ClientId':\"a079a6c5-a90f-45e9-8bd1-a1dcd3002cc3\",\r\n                    allowConflicts:false,\r\n                    employeeId:\"\",\r\n                    date:PlandayShifts1[@date],\r\n                    startTime:Right(PlandayShifts1[@startDateTime],5),\r\n                    endTime:Right(PlandayShifts1[@endDateTime],5),\r\n                    employeeGroupId:PlandayShifts1[@employeeGroupId],\r\n                    comment:\"Set to open for Mandatory Training\"\r\n                    }\r\n                )\r\n                )\r\n                \r\n                )\r\n            ))\r\n        );\r\nForAll(colToSend,\r\n\r\n    Planday.CreateShift({\r\n        allowConflicts:false,\r\n        'X-ClientId':\"a079a6c5-a90f-45e9-8bd1-a1dcd3002cc3\",\r\n        date:Text(crff5_startdate,\"yyyy-mm-dd\"),\r\n        comment:ThisItem.'Type of Training',\r\n        shiftTypeId:71233,\r\n        departmentId:7770,\r\n        startTime:\"09:15\",\r\n        endTime:\"15:45\",\r\n        useBreaks:true,\r\n        employeeGroupId:GroupId,\r\n        positionId:PositionID,\r\n        employeeId:ItemId});\r\n    \r\n    );\r\n\r\n\r\n//Day Two\r\n\r\nClear(PlandayShifts2);\r\n\r\n\r\nClearCollect(colCurrentDnD, Filter(PowerDragDrop2_2.CurrentItems,Text(DropZoneId)=Text(ThisItem.TrainingSessionD2)));\r\nClearCollect(colToPost,\r\n    Ungroup(\r\n        DropColumns(\r\n            AddColumns(\r\n                colCurrentDnD,\r\n                Mygroupedcolumn,\r\n                Filter(\r\n                    colSessions,\r\n                    Text(TrainingSessionD2)=Text(colCurrentDnD[@DropZoneId])\r\n                )\r\n            ),\r\n            DropZoneId\r\n        ),\r\n        Mygroupedcolumn\r\n    )\r\n);\r\n\r\nClearCollect(colToSend, \r\n    AddColumns(\r\n        colToPost,PositionID,\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Quarry House\",\"20843\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Beech House\",\"20842\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Field House\",\"20845\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Glebe House\",\"20728\",\"\")))),\r\n        GroupId,\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Quarry House\",\"21754\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Beech House\",\"21752\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Field House\",\"21755\",\r\n        If(LookUp(Withhomesx,Text(ItemId)=Text(id),Home)=\"Glebe House\",\"21753\",\"\"))))));\r\n\r\n\r\n\r\nClearCollect(PlandayShifts2,Planday.GetShifts({              \r\n        //employeeId:\"\",\r\n        from:Text(Date(Year(ThisItem.'Day 2'),Month(ThisItem.'Day 2'),Day(ThisItem.'Day 2')),\"yyyy-mm-dd\"),\r\n        to:Text(Date(Year(ThisItem.'Day 2'),Month(ThisItem.'Day 2'),Day(ThisItem.'Day 2')),\"yyyy-mm-dd\"),\r\n        'X-ClientId':\"a079a6c5-a90f-45e9-8bd1-a1dcd3002cc3\",\r\n        Limit:\"5000\"}).data);\r\nRemoveIf(PlandayShifts2, !(employeeId in Concat(colToSend,ItemId,\",\"))||Len(employeeId)<3);    \r\n\r\nForAll(PlandayShifts2,\r\n    If(PlandayShifts2[@shiftTypeId]=70768||Text(PlandayShifts2[@shiftTypeId])=\"70768\",\r\n        Collect(Holidays,{Name: LookUp(Withhomesx,Text(id)=Text(PlandayShifts2[@employeeId]),FullName),Type: \"Holiday\",Date: PlandayShifts2[@date]}),\r\n        If(PlandayShifts2[@shiftTypeId]=71868,\r\n            Collect(Holidays,{Name: LookUp(Withhomesx,Text(id)=Text(PlandayShifts2[@employeeId]),FullName),Type: \"Unpaid Leave\",Date: PlandayShifts2[@date]}),\r\n            If(PlandayShifts2[@shiftTypeId]=71851,\r\n                Collect(Holidays,{Name: LookUp(Withhomesx,Text(id)=Text(PlandayShifts2[@employeeId]),FullName),Type: \"Sick Leave\",Date: PlandayShifts2[@date]}),\r\n                Collect(Updates,Planday.UpdateShift(PlandayShifts2[@id],{\r\n                    'X-ClientId':\"a079a6c5-a90f-45e9-8bd1-a1dcd3002cc3\",\r\n                    allowConflicts:false,\r\n                    employeeId:\"\",\r\n                    date:PlandayShifts2[@date],\r\n                    startTime:Right(PlandayShifts2[@startDateTime],5),\r\n                    endTime:Right(PlandayShifts2[@endDateTime],5),\r\n                    employeeGroupId:PlandayShifts2[@employeeGroupId],\r\n                    comment:\"Set to open for Mandatory Training\"\r\n                    }\r\n                )\r\n                )\r\n                )\r\n            )\r\n        )\r\n    );\r\n\r\n\r\nIf(CountRows(Holidays)>0,Set(HolRept,\"true\"));\r\n\r\nForAll(colToSend,\r\n\r\n    \r\n    Planday.CreateShift({\r\n        allowConflicts:false,\r\n        'X-ClientId':\"a079a6c5-a90f-45e9-8bd1-a1dcd3002cc3\",\r\n        date: Text(crff5_enddate,\"yyyy-mm-dd\"),\r\n        comment:ThisItem.'Type of Training',\r\n        shiftTypeId:71233,\r\n        departmentId:7770,\r\n        startTime:\"09:15\",\r\n        endTime:\"15:45\",\r\n        useBreaks:true,\r\n        employeeGroupId:GroupId,\r\n        positionId:PositionID,\r\n        employeeId:Value(ItemId)})\r\n    );\r\n\r\n\r\n\r\nClearCollect(colToSaved1,AddColumns(Filter(PowerDragDrop2_1.CurrentItems,HasMovedZone=true),DayList,\"Day1\"));\r\nForAll(colToSaved1,\r\n   Patch(SaveMandatories, LookUp(SaveMandatories,DayList=\"Day1\"&& ItemID=ItemId),\r\n   {\r\n       DayList:colToSaved1[@DayList], \r\n       DropzoneID:colToSaved1[@DropZoneId],\r\n       ItemID:colToSaved1[@ItemId],\r\n       PositionID:colToSaved1[@Position]\r\n       }\r\n       )\r\n       );\r\n\r\nClearCollect(colToSaved2,AddColumns(Filter(PowerDragDrop2_2.CurrentItems,HasMovedZone=true),DayList,\"Day2\"));       \r\nForAll(colToSaved2,\r\n   Patch(SaveMandatories, LookUp(SaveMandatories,DayList=\"Day2\"&&ItemID=ItemId),\r\n   {\r\n       DayList:colToSaved2[@DayList], \r\n       DropzoneID:colToSaved2[@DropZoneId],\r\n       ItemID:colToSaved2[@ItemId],\r\n       PositionID:colToSaved2[@Position]\r\n       }\r\n       )\r\n       );"
                        PaddingRight: =0.00
                        PaddingTop: =0.00
                        Visible: |-
                          =If(User().Email="Darren.taggart@bristolcarehomes.co.uk"||User().Email="Val.knight@bristolcarehomes.co.uk",
                          If(Or(IfError(First(PowerDragDrop2_1.CurrentItems).ItemId,false,true)=false,IfError(First(PowerDragDrop2_2.CurrentItems).ItemId,false,true)=false),false,true),false)
